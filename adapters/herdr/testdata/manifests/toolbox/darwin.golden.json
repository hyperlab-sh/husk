{
  "manifest_version": 2,
  "protocol": 2,
  "id": "sample-tools",
  "name": "Sample tools",
  "version": "1.2.3",
  "description": "An anonymized command and pane catalog",
  "command": [
    "/opt/husk-herdr",
    "run",
    "/plugins/toolbox"
  ],
  "actions": [
    {
      "id": "sample-tools.inspect-selection",
      "title": "Inspect selection",
      "description": "Show the active selection",
      "public": true
    },
    {
      "id": "sample-tools.notify",
      "title": "Notify",
      "public": true
    },
    {
      "id": "sample-tools.pane-picker",
      "title": "Open Picker",
      "public": true
    },
    {
      "id": "sample-tools.pane-sidebar",
      "title": "Open Sidebar",
      "public": true
    }
  ],
  "events": {
    "subscribe": []
  },
  "keybindings": [],
  "x-herdr": {
    "id": "sample:tools",
    "min_version": "0.9.0",
    "actions": [
      {
        "id": "inspect:selection",
        "title": "Inspect selection",
        "description": "Show the active selection",
        "platforms": [
          "linux",
          "macos"
        ],
        "command": [
          "./tools/inspect",
          "--selection"
        ],
        "contexts": [
          "workspace",
          "pane"
        ]
      },
      {
        "id": "notify",
        "title": "Notify",
        "command": [
          "sh",
          "-c",
          "printf '%s' \"$HERDR_PLUGIN_ID\""
        ]
      }
    ],
    "panes": [
      {
        "id": "picker",
        "title": "Picker",
        "command": [
          "./tools/picker",
          "--interactive"
        ],
        "placement": "popup",
        "width": "70%",
        "height": 18
      },
      {
        "id": "sidebar",
        "title": "Sidebar",
        "platforms": [
          "linux",
          "macos"
        ],
        "command": [
          "./tools/sidebar"
        ],
        "placement": "split",
        "width": 30
      }
    ],
    "startup": [
      {
        "platforms": [
          "linux",
          "macos"
        ],
        "command": [
          "node",
          "./tools/watcher.js",
          "--daemon"
        ]
      }
    ],
    "events": [
      "pane.focused"
    ]
  }
}
