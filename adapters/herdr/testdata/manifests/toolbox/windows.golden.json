{
  "manifest_version": 2,
  "protocol": 2,
  "id": "sample-tools",
  "name": "Sample tools",
  "version": "1.2.3",
  "description": "An anonymized command and pane catalog",
  "command": [
    "/opt/husk-herdr",
    "run",
    "/plugins/toolbox"
  ],
  "actions": [
    {
      "id": "sample-tools.inspect-selection-windows",
      "title": "Inspect selection",
      "public": true
    },
    {
      "id": "sample-tools.notify",
      "title": "Notify",
      "public": true
    },
    {
      "id": "sample-tools.pane-picker",
      "title": "Open Picker",
      "public": true
    },
    {
      "id": "sample-tools.pane-picker-windows",
      "title": "Open Picker",
      "public": true
    }
  ],
  "events": {
    "subscribe": []
  },
  "keybindings": [],
  "x-herdr": {
    "id": "sample:tools",
    "min_version": "0.9.0",
    "actions": [
      {
        "id": "inspect-selection-windows",
        "title": "Inspect selection",
        "platforms": [
          "windows"
        ],
        "command": [
          "powershell",
          "-Command",
          "Write-Output inspected"
        ]
      },
      {
        "id": "notify",
        "title": "Notify",
        "command": [
          "sh",
          "-c",
          "printf '%s' \"$HERDR_PLUGIN_ID\""
        ]
      }
    ],
    "panes": [
      {
        "id": "picker",
        "title": "Picker",
        "command": [
          "./tools/picker",
          "--interactive"
        ],
        "placement": "popup",
        "width": "70%",
        "height": 18
      },
      {
        "id": "picker-windows",
        "title": "Picker",
        "platforms": [
          "windows"
        ],
        "command": [
          "powershell",
          "-File",
          "./tools/picker.ps1"
        ],
        "placement": "popup",
        "width": 80,
        "height": "60%"
      }
    ],
    "startup": [],
    "events": [
      "pane.focused"
    ],
    "link_handlers": [
      {
        "id": "issue",
        "title": "Inspect issue",
        "pattern": "^https://example\\.invalid/issues/[0-9]+$",
        "action": "notify"
      },
      {
        "id": "fallback",
        "title": "Inspect other link",
        "pattern": "^https?://",
        "action": "notify"
      }
    ]
  }
}
